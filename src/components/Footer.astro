---
const year = new Date().getFullYear();
---
<footer class="foot rule">
  <div class="container">
    <div class="foot__top">
      <a class="wordmark foot__mark" href="/">A<i>I</i>nWorks</a>
      <nav class="foot__links" aria-label="푸터 메뉴">
        <a href="https://github.com/AInWorks">GitHub</a>
        <a href="#products">만드는 것</a>
        <a href="#contact">연락</a>
      </nav>
    </div>

    <!-- 국내 법인은 상호·대표자·사업자등록번호·주소 표기가 필요합니다. TODO: 실제 값 -->
    <p class="foot__legal">
      AInWorks · 대표 ○○○ · 사업자등록번호 000-00-00000<br />
      TODO: 주소
    </p>
    <p class="foot__copy label">© {year} AInWorks</p>
  </div>
</footer>

<style>
  .foot { padding-block: var(--s-6) var(--s-5); background: var(--bg-2); }
  .foot__top {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s-3);
    padding-bottom: var(--s-5);
  }
  .foot__mark { font-size: 1.05rem; }
  .foot__links { display: flex; flex-wrap: wrap; gap: var(--s-4); font-size: .875rem; }
  .foot__links a { color: var(--ink-2); text-decoration: none; transition: color .2s ease; }
  .foot__links a:hover { color: var(--ink); }
  .foot__legal { font-size: .8rem; color: var(--ink-3); line-height: 1.85; }
  .foot__copy { margin-top: var(--s-3); }
</style>
