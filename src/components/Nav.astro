---
const links = [
  { href: '#name',     label: '이름' },
  { href: '#products', label: '만드는 것' },
  { href: '#team',     label: '팀' },
];
---
<header class="nav">
  <div class="container nav__inner">
    <a class="wordmark nav__mark" href="/" aria-label="AInWorks 홈">A<i>I</i>nWorks</a>

    <nav class="nav__links" aria-label="주요 메뉴">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      <button class="toggle" type="button" data-theme-toggle>
        <svg class="toggle__sun" viewBox="0 0 24 24" width="17" height="17" fill="none"
             stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" /><path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.4 5.4l1.4 1.4M17.2 17.2l1.4 1.4M18.6 5.4l-1.4 1.4M6.8 17.2l-1.4 1.4" />
        </svg>
        <svg class="toggle__moon" viewBox="0 0 24 24" width="17" height="17" fill="none"
             stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" />
        </svg>
      </button>
      <a class="btn nav__cta" href="#contact">연락하기</a>

      <button class="burger" type="button" aria-expanded="false"
              aria-controls="mobile-menu" aria-label="메뉴 열기">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" hidden>
    <nav class="container menu__inner" aria-label="모바일 메뉴">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn menu__cta" href="#contact">연락하기</a>
    </nav>
  </div>
</header>

<script is:inline>
  {
    const burger = document.querySelector('.burger');
    const menu = document.getElementById('mobile-menu');
    if (burger && menu) {
      const set = (open) => {
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
        burger.classList.toggle('is-open', open);
        menu.hidden = !open;
      };
      burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      // 데스크톱 폭으로 넓어지면 열린 채로 남지 않게 닫는다
      matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) set(false); });
    }
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid transparent;
  }
  .nav__inner { display: flex; align-items: center; gap: var(--s-4); height: 66px; }
  .nav__mark { font-size: 1.1rem; margin-right: auto; }

  .nav__links { display: flex; gap: var(--s-4); font-size: .9rem; }
  .nav__links a { text-decoration: none; color: var(--ink-2); transition: color .2s ease; }
  .nav__links a:hover { color: var(--ink); }

  .nav__right { display: flex; align-items: center; gap: var(--s-2); }

  .toggle {
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: color .2s ease, border-color .2s ease;
  }
  .toggle:hover { color: var(--ink); border-color: var(--ink-3); }
  /* 두 아이콘을 겹쳐두고 페이드 + 회전으로 교차시킨다 (display 스위치는 툭 끊긴다) */
  .toggle svg {
    grid-area: 1 / 1;
    transition: opacity .4s cubic-bezier(.4,0,.2,1), transform .5s cubic-bezier(.4,0,.2,1);
  }
  .toggle__sun  { opacity: 1; transform: rotate(0) scale(1); }
  .toggle__moon { opacity: 0; transform: rotate(-70deg) scale(.6); }

  /* 지금이 라이트면 "다크로 가는" 달을, 다크면 해를 보여준다 */
  :global(:root[data-theme='dark']) .toggle__sun  { opacity: 0; transform: rotate(70deg) scale(.6); }
  :global(:root[data-theme='dark']) .toggle__moon { opacity: 1; transform: rotate(0) scale(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .toggle__sun  { opacity: 0; transform: rotate(70deg) scale(.6); }
    :global(:root:not([data-theme='light'])) .toggle__moon { opacity: 1; transform: rotate(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle svg { transition: none; }
  }

  .nav__cta { padding: .58em 1.1em; }

  /* ── 모바일 메뉴 ── */
  .burger {
    /* grid 로 두면 암시적 행이 버튼 높이만큼 늘어나 두 획이 22px 씩 벌어진다.
       flex + gap 으로 두 획을 실제로 붙여야 translateY 로 겹칠 수 있다. */
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 34px; height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: transparent;
    cursor: pointer;
  }
  .burger span {
    display: block;
    width: 16px; height: 1.5px;
    background: var(--ink);
    transition: transform .25s cubic-bezier(.4,0,.2,1), opacity .2s ease;
  }
  .burger.is-open span:first-child { transform: translateY(2.75px) rotate(45deg); }
  .burger.is-open span:last-child  { transform: translateY(-2.75px) rotate(-45deg); }

  .menu {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    animation: menuIn .22s cubic-bezier(.4,0,.2,1);
  }
  .menu[hidden] { display: none; }
  @keyframes menuIn { from { opacity: 0; transform: translateY(-6px); } }

  .menu__inner { display: grid; gap: var(--s-1); padding-block: var(--s-3); }
  .menu__inner a:not(.btn) {
    text-decoration: none;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
    padding: .65rem 0;
  }
  .menu__cta { justify-self: start; margin-top: var(--s-2); }

  @media (max-width: 760px) {
    .nav__links { display: none; }
    .nav__cta { display: none; }
    .burger { display: flex; }
  }
  @media (min-width: 761px) {
    .menu { display: none; }
  }

  /* 손가락은 마우스보다 굵다 — 터치 기기에서는 44px 로 키운다 */
  @media (pointer: coarse) {
    .toggle, .burger { width: 44px; height: 44px; }
  }
</style>
